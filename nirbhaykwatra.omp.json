{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "foreground": "#FFFFFF",
          "background": "#D01117",
          "template": " {{ .Icon }}  {{.UserName}} ",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "options": {
            "cache_duration": "none"
          }
        },
        {
          "type": "path",
          "style": "diamond",
          "foreground": "#48304B",
          "background": "#B47AEA",
          "template": " {{ .Path }}  ",
          "trailing_diamond": "\ue0b0",
          "options": {
            "cache_duration": "none",
            "style": "folder",
            "home_icon": "\uf015",
            "folder_icon": "\uf07b"
          },
          "leading_powerline_symbol": "\ue0b2",
          "powerline_symbol": "\ue0b7"
        },
        {
          "type": "git",
          "style": "diamond",
          "foreground": "#262b44",
          "background": "#ffffff",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#f77622{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#e43b44{{ end }}",
            "{{ if gt .Ahead 0 }}#2ce8f5{{ end }}",
            "{{ if gt .Behind 0 }}#f77622{{ end }}"
          ],
          "template": "",
          "trailing_diamond": "\ue0b0",
          "options": {
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "foreground": "#57c4dc",
          "background": "#23272f",
          "template": " {{ .FormattedMs }} ",
          "trailing_diamond": "\ue0b0",
          "options": {
            "cache_duration": "none",
            "style": "roundrock",
            "threshold": 0
          }
        },
        {
          "type": "status",
          "style": "diamond",
          "foreground": "#ffffff",
          "background": "#009823",
          "background_templates": [
            "{{ if gt .Code 0 }}#ff0044{{ end }}"
          ],
          "template": " \uf0e7 ",
          "trailing_diamond": "\ue0b4",
          "options": {
            "always_enabled": true,
            "cache_duration": "none"
          }
        }
      ],
      "newline": false
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "unity",
          "style": "diamond",
          "powerline_symbol": "\ue0b0",
          "template": " \ue721 {{ .UnityVersion }} ",
          "foreground": "#000000",
          "background": "#ffffff",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4"
        },
        {
          "type": "python",
          "style": "diamond",
          "powerline_symbol": "\ue0b0",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "foreground": "#FF9505",
          "background": "#254E70",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4"
        },
        {
          "type": "react",
          "style": "diamond",
          "powerline_symbol": "\ue0b0",
          "template": " \ue7ba {{ .Full }} ",
          "foreground": "#57c4dc",
          "background": "#23272f",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4"
        },
        {
          "type": "sysinfo",
          "style": "diamond",
          "foreground": "#ffffff",
          "background": "#D01117",
          "template": " \uf4bc {{ round .PhysicalPercentUsed .Precision }}% | {{ (div ((sub .PhysicalTotalMemory .PhysicalFreeMemory)|float64) 1000000000.0) }}/{{ (div .PhysicalTotalMemory 1000000000.0) }}GB ",
          "trailing_diamond": "\ue0b4",
          "options": {
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b6",
          "interactive": true
        },
        {
          "type": "ipify",
          "style": "diamond",
          "powerline_symbol": "\ue0b0",
          "template": " \uf484 {{ .IP }} ",
          "foreground": "#48304B",
          "background": "#B47AEA",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4"
        }
      ],
      "leading_diamond": "\ue0b6",
      "trailing_diamond": "\ue0b4",
      "force": false
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\u2570\u2500",
          "foreground": "#21c7c7",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "\ue285\ueab6 ",
          "foreground": "#e0f8ff",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ef5350{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ]
}